# ============================================================
# LaTeX build outputs and auxiliary files
# ============================================================
*.aux
*.bbl
*.bcf
*.blg
*.fls
*.fdb_latexmk
*.log
*.lof
*.lol
*.lot
*.out
*.toc
*.nav
*.snm
*.vrb
*.idx
*.ilg
*.ind
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.ist
*.xdy
*.run.xml
*.synctex
*.synctex.gz
*.pdfsync

# Output directories (LaTeX build)
output/
buku2/output/

# Hasil kompilasi per bab (buku_ajar/chapters/NN/chapter.pdf)
buku_ajar/chapters/*/chapter.pdf

# Hasil kompilasi slide (ppt/minggu-NN.pdf).
# Sumbernya ada di ppt/src/ dan PDF dapat dibangun ulang dengan
# ppt/compile_ppt.bat, jadi tidak disimpan di repositori.
ppt/*.pdf

# Hasil kompilasi modul praktikum (modul_praktikum/main.pdf).
# Sumbernya main.tex dan dapat dibangun ulang dengan
# compile_modul_praktikum.bat, jadi tidak disimpan di repositori.
modul_praktikum/main.pdf

# Catatan perintah kerja lokal (perintah2.txt, perintah3.txt, ...).
# perintah.text yang sudah ada di repositori tidak ikut terabaikan.
perintah*.txt

# Materi rujukan pihak ketiga tidak disertakan ke repositori
referensi/

# ============================================================
# Hasil kompilasi assembler (TASM/TLINK): OBJ, EXE, COM, LST, MAP.
# Sumber .asm tetap disimpan; berkas biner dan listing dapat
# dibangun ulang, jadi tidak masuk repositori.
# Pola ditulis dua kali karena TASM memakai ekstensi huruf besar.
# ============================================================
*.obj
*.OBJ
*.exe
*.EXE
*.com
*.COM
*.lst
*.LST
*.map
*.MAP

# ============================================================
# Operating system files
# ============================================================
desktop.ini
.DS_Store
Thumbs.db
ehthumbs.db
*.lnk

# ============================================================
# Editor and IDE
# ============================================================
*.swp
*.swo
*~
*.bak
*.tmp
.vscode/
*.sublime-project
*.sublime-workspace

# ============================================================
# Cursor / AI (optional - uncomment if desired)
# ============================================================
# .cursor/
# .cursorignore

# ============================================================
# Temporary and backup
# ============================================================
*.backup
*.orig
*.rej
